# Settings Docker Compose reads from .env (next to docker-compose.yml).
# Generate the secrets with the PowerShell snippet in docs/docker.md; never commit .env.

POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Encrypts users' own LLM keys while they wait in Redis (32+ characters).
SECRET_KEY=
# Shared with web/.env.local: the web app signs API tokens with it (32+ characters).
API_JWT_SECRET=
# Optional server-side LLM keys (users can bring their own).
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
