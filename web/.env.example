# Copy to .env.local and fill in. Never commit .env.local.

# Auth.js: random secret that encrypts the session cookie.
#   Generate:  npx auth secret     (or any 32+ random characters)
AUTH_SECRET=

# GitHub OAuth app (github.com/settings/developers -> New OAuth App)
#   Homepage URL:            http://localhost:3000
#   Authorization callback:  http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google sign-in (optional; the button appears only when both are set)
#   console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web application)
#   Authorized JavaScript origin:  http://localhost:3000
#   Authorized redirect URI:       http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The FastAPI backend, and the secret shared with it (same value as API_JWT_SECRET in the API's .env).
API_URL=http://localhost:8000
API_JWT_SECRET=
